NODE_ENV=development
PORT=3000
# Required in production (dev auto-generates into data/.dev-secrets.json):
# JWT_SECRET=$(openssl rand -base64 48)
# DATA_ENCRYPTION_KEY=$(openssl rand -base64 32)   # encrypts client keys in the DB
CORS_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080
# Set to number of reverse proxies in front of the API (1 behind Caddy/nginx)
# TRUST_PROXY=1

# Payments: mock (dev only) | sber (not implemented yet)
PAYMENT_PROVIDER=mock
# SBER_API_URL= SBER_USERNAME= SBER_PASSWORD= SBER_WEBHOOK_SECRET=

# WireGuard. WG_APPLY_MODE=none keeps peers in DB only; wg runs `wg set` on this host.
WG_APPLY_MODE=none
WG_SERVER_NAME=Server 1
WG_SERVER_REGION=RU
WG_ENDPOINT=vpn.example.com:51820
WG_SERVER_PUBLIC_KEY=
WG_INTERFACE=wg0
WG_SUBNET=10.8.0.0/24
WG_DNS=1.1.1.1, 1.0.0.1
VPN_MAX_PROFILES_PER_USER=1

# VLESS + Reality (Xray). XRAY_APPLY_MODE=none keeps accounts in the DB only; xray manages users via the local gRPC API.
# Empty XRAY_REALITY_PUBLIC_KEY = VLESS disabled. (The Reality PRIVATE key lives only in Xray's config on the VPS.)
XRAY_APPLY_MODE=none
XRAY_BIN=/usr/local/bin/xray
XRAY_API=127.0.0.1:10085
XRAY_HOST=vpn.example.com
XRAY_PORT=8443
XRAY_SNI=www.microsoft.com
XRAY_SHORT_ID=
XRAY_REALITY_PUBLIC_KEY=
VLESS_MAX_ACCOUNTS_PER_USER=1
# uTLS fingerprint in issued links: 'ios' (small ClientHello, one TCP packet) or 'chrome' (1.8 KB, split; stalls on some mobile networks)
XRAY_FINGERPRINT=ios
